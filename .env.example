# --- Nightwatch environment (copy to .env for local dev; set as Cloud Run vars/secrets in prod) ---

# Model — Gemini 3.5+ per the hackathon rules. On Vertex, 3.x is served from the "global"
# endpoint only (regional endpoints 404 on generate), so keep LOCATION=global for Gemini.
GEMINI_MODEL=gemini-3.5-flash
# Open Gemma model (managed on Vertex global) — fast first-pass triage classifier.
GEMMA_MODEL=gemma-4-26b-a4b-it-maas

# Vertex AI routing (recommended for the demo — gives Cloud logs to show as proof).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# For local dev with an API key instead of Vertex, set GOOGLE_GENAI_USE_VERTEXAI=FALSE and:
# GOOGLE_API_KEY=your-ai-studio-key

# What to watch — wallet/contract addresses and/or symbols, comma-separated.
NIGHTWATCH_WATCHLIST=0xYourWallet,BTC,ETH
# Items below this confidence go to the brief for review instead of auto-action.
NIGHTWATCH_CONFIDENCE=0.6

# --- Action integrations (optional; tools no-op cleanly when unset) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Run-trigger auth (optional locally; deploy.sh manages it via Secret Manager) ---
# When set, POST /run and /pubsub/push require this token (Bearer header or ?token=).
# Leave blank for local dev to keep the trigger endpoints open.
RUN_TOKEN=
