# --- Nightwatch environment (copy to .env for local dev; set as Cloud Run vars/secrets in prod) ---

# Model — must be Gemini 3.5+ per the hackathon rules. Verify the exact id in your region.
GEMINI_MODEL=gemini-3.5-pro

# Vertex AI routing (recommended for the demo — gives Cloud logs to show as proof).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# For local dev with an API key instead of Vertex, set GOOGLE_GENAI_USE_VERTEXAI=FALSE and:
# GOOGLE_API_KEY=your-ai-studio-key

# What to watch — wallet/contract addresses and/or symbols, comma-separated.
NIGHTWATCH_WATCHLIST=0xYourWallet,BTC,ETH
# Items below this confidence go to the brief for review instead of auto-action.
NIGHTWATCH_CONFIDENCE=0.6

# --- Action integrations (optional; tools no-op cleanly when unset) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
